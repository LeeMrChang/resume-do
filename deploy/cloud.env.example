# Server-only /home/ubuntu/resume-do/deploy/.env. Bootstrap generates independent passwords.
RESUME_DO_MYSQL_ROOT_PASSWORD=replace_with_64_hex_characters
RESUME_DO_DB_PASSWORD=replace_with_different_64_hex_characters
RESUME_DO_MYSQL_IMAGE=mirror.ccs.tencentyun.com/library/mysql:8.4
RESUME_DO_MYSQL_MEMORY=768m
RESUME_DO_API_MEMORY=768m
RESUME_DO_WORKER_MEMORY=1g
RESUME_DO_WEB_MEMORY=128m
RESUME_DO_AI_ENABLED=false
RESUME_DO_AI_API_KEY=
RESUME_DO_AI_MODEL=deepseek-flash
RESUME_DO_AI_TIMEOUT_MS=30000
RESUME_DO_AI_DAILY_LIMIT=20
RESUME_DO_AI_PER_MINUTE_LIMIT=5
