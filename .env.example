# Shared by Java API and PDF worker. Copy to .env and load it in each terminal.
RESUME_DO_DB_HOST=127.0.0.1
RESUME_DO_DB_PORT=3306
RESUME_DO_DB_NAME=resume_do
RESUME_DO_DB_USER=resume_do
RESUME_DO_DB_PASSWORD=change_me
# Relative to apps/api or apps/pdf-worker; use an absolute path in IDE run settings.
RESUME_DO_STORAGE_DIR=../../data

# HTTP services
RESUME_DO_API_PORT=8080
RESUME_DO_WEB_PORT=5173

# PDF worker: empty uses Playwright Chromium; chrome uses installed Google Chrome.
RESUME_DO_BROWSER_CHANNEL=
RESUME_DO_WORKER_ID=resume-do-worker-1
RESUME_DO_POLL_MS=800
RESUME_DO_RENDER_TIMEOUT_MS=30000
RESUME_DO_DOWNLOAD_TTL_MINUTES=10
